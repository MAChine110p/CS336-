  <meta name="description" content="Abstract page for arXiv paper 2411.02265: Hunyuan-Large: An Open-Source MoE Model with 52 Billion Activated Parameters by Tencent"><meta property="og:type" content="website" />
<meta property="og:site_name" content="arXiv.org" />
<meta property="og:title" content="Hunyuan-Large: An Open-Source MoE Model with 52 Billion Activated Parameters by Tencent" />
<meta property="og:url" content="https://arxiv.org/abs/2411.02265v3" />
<meta property="og:image" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
